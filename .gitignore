ai-service/venv/
ai-service/__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Model files (nặng, quản lý riêng bằng Git LFS hoặc tải thủ công)
ai-service/models/*.pt
ai-service/models/*.onnx
ai-service/models/*.bin

# File kết quả training (nặng)
ai-service/*.zip

# ─── Backend ──────────────────────────────────────────────────────────────────
